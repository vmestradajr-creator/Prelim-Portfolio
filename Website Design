:root {
    --background: #f7f7f5;
    --surface: #ffffff;
    --text: #151515;
    --muted: #737373;
    --border: #dededb;
    --accent: #315b7d;
    --dark: #17191c;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Inter", sans-serif;
    background: var(--background);
    color: var(--text);
    line-height: 1.6;
}

a {
    color: inherit;
    text-decoration: none;
}


/* =========================
   NAVIGATION
========================= */

.navbar {
    position: sticky;
    top: 0;
    z-index: 1000;

    background: rgba(247, 247, 245, 0.92);

    backdrop-filter: blur(15px);

    border-bottom: 1px solid var(--border);
}

.nav-container {
    max-width: 1200px;
    margin: auto;

    padding: 18px 30px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -1px;
}

.logo span {
    color: var(--accent);
}

nav {
    display: flex;
    gap: 35px;
}

nav a {
    font-size: 13px;
    color: var(--muted);

    transition: 0.2s;
}

nav a:hover {
    color: var(--text);
}

.nav-button {
    border: 1px solid var(--text);

    padding: 8px 16px;

    font-size: 12px;

    transition: 0.2s;
}

.nav-button:hover {
    background: var(--text);
    color: white;
}


/* =========================
   HERO
========================= */

.hero {
    max-width: 1200px;
    min-height: 85vh;

    margin: auto;

    padding: 120px 30px;

    display: flex;
    align-items: center;

    justify-content: space-between;
}

.hero-content {
    max-width: 850px;
}

.eyebrow {
    font-size: 11px;
    font-weight: 600;

    letter-spacing: 2px;

    color: var(--accent);

    margin-bottom: 22px;
}

.hero h1 {
    font-size: clamp(45px, 7vw, 85px);

    line-height: 1.02;

    letter-spacing: -4px;

    font-weight: 600;
}

.hero h1 span {
    color: var(--muted);
}

.hero-description {
    max-width: 650px;

    margin-top: 30px;

    color: var(--muted);

    font-size: 16px;
}

.hero-actions {
    display: flex;

    align-items: center;

    gap: 25px;

    margin-top: 35px;
}

.primary-button {
    padding: 13px 22px;

    background: var(--text);

    color: white;

    font-size: 13px;

    transition: 0.2s;
}

.primary-button:hover {
    background: var(--accent);
}

.text-button {
    font-size: 13px;

    color: var(--muted);
}

.text-button:hover {
    color: var(--text);
}

.hero-number {
    align-self: flex-end;

    font-size: 12px;

    color: var(--muted);

    letter-spacing: 2px;
}


/* =========================
   ABOUT
========================= */

.about {
    max-width: 1200px;

    margin: auto;

    padding: 120px 30px;

    display: grid;

    grid-template-columns: 200px 1fr;

    gap: 70px;

    border-top: 1px solid var(--border);
}

.section-label {
    font-size: 11px;

    letter-spacing: 2px;

    color: var(--muted);

    font-weight: 600;
}

.section-label span {
    color: var(--accent);

    margin-right: 10px;
}

.about-content {
    max-width: 800px;
}

.about-content h2 {
    font-size: 45px;

    line-height: 1.1;

    letter-spacing: -2px;

    font-weight: 500;

    margin-bottom: 30px;
}

.about-content h2 span {
    color: var(--muted);
}

.about-content p {
    max-width: 700px;

    color: var(--muted);

    margin-bottom: 15px;
}


/* =========================
   ACTIVITIES
========================= */

.activities {
    max-width: 1200px;

    margin: auto;

    padding: 120px 30px;
}

.section-heading {
    display: flex;

    justify-content: space-between;

    align-items: end;

    margin-bottom: 70px;
}

.section-heading h2 {
    font-size: 48px;

    letter-spacing: -2px;

    font-weight: 500;
}

.section-heading > p {
    color: var(--muted);

    font-size: 13px;
}


/* ACTIVITY */

.activity {
    display: grid;

    grid-template-columns: 1fr 1fr;

    min-height: 500px;

    border-top: 1px solid var(--border);
}

.activity-info {
    padding: 70px 50px 70px 0;

    display: flex;

    flex-direction: column;

    justify-content: center;
}

.activity-number {
    font-size: 13px;

    color: var(--accent);

    margin-bottom: 25px;
}

.activity-category {
    font-size: 10px;

    letter-spacing: 2px;

    color: var(--muted);

    margin-bottom: 15px;
}

.activity h3 {
    font-size: 43px;

    line-height: 1.05;

    letter-spacing: -2px;

    font-weight: 500;
}

.activity-description {
    max-width: 450px;

    margin-top: 25px;

    color: var(--muted);

    font-size: 14px;
}

.view-link {
    margin-top: 30px;

    color: var(--accent);

    font-size: 13px;

    font-weight: 500;
}


/* PREVIEWS */

.activity-preview {
    min-height: 500px;

    display: flex;

    align-items: center;

    justify-content: center;

    overflow: hidden;
}

.preview-one {
    background: #e7e5df;
}

.preview-two {
    background: #dce4e8;
}

.preview-three {
    background: #e6e2da;
}


/* MOCK SLIDE */

.mock-slide {
    width: 65%;

    aspect-ratio: 4 / 3;

    background: white;

    padding: 35px;

    box-shadow: 0 20px 50px rgba(0,0,0,0.08);
}

.mock-small {
    font-size: 8px;

    letter-spacing: 2px;

    color: #777;
}

.mock-title {
    margin-top: 50px;

    font-size: 30px;

    font-weight: 600;

    line-height: 1.05;
}

.mock-line {
    width: 50px;

    height: 3px;

    background: var(--accent);

    margin-top: 20px;
}

.mock-boxes {
    display: flex;

    gap: 8px;

    margin-top: 60px;
}

.mock-boxes span {
    width: 30px;

    height: 30px;

    border: 1px solid #ccc;
}


/* TYPE PREVIEW */

.type-preview {
    width: 65%;

    aspect-ratio: 4 / 3;

    background: white;

    padding: 40px;

    box-shadow: 0 20px 50px rgba(0,0,0,0.08);
}

.type-label {
    font-size: 8px;

    letter-spacing: 2px;

    color: var(--accent);
}

.type-preview h4 {
    font-size: 42px;

    line-height: .95;

    margin-top: 45px;

    letter-spacing: -2px;
}

.type-preview > p:last-child {
    margin-top: 50px;

    font-size: 8px;

    letter-spacing: 2px;

    color: #777;
}


/* INFO PREVIEW */

.info-card {
    width: 65%;

    aspect-ratio: 4 / 3;

    background: var(--dark);

    color: white;

    padding: 40px;

    box-shadow: 0 20px 50px rgba(0,0,0,0.12);
}

.info-card span {
    font-size: 35px;

    color: #aaa;
}

.info-card h4 {
    margin-top: 70px;

    font-size: 25px;

    line-height: 1.05;

    letter-spacing: -1px;
}

.info-card p {
    margin-top: 30px;

    font-size: 8px;

    letter-spacing: 2px;

    color: #aaa;
}


/* =========================
   PROCESS
========================= */

.process {
    background: var(--dark);

    color: white;

    padding: 120px 30px;
}

.process > .section-label {
    max-width: 1200px;

    margin: auto;

    color: #888;
}

.process-header {
    max-width: 1200px;

    margin: 80px auto;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 100px;
}

.process-header h2 {
    font-size: 65px;

    line-height: 1;

    letter-spacing: -3px;

    font-weight: 500;
}

.process-header h2 span {
    color: #777;
}

.process-header p {
    color: #999;

    max-width: 450px;
}

.process-grid {
    max-width: 1200px;

    margin: auto;

    display: grid;

    grid-template-columns: repeat(4, 1fr);

    border-top: 1px solid #333;
}

.process-item {
    padding: 30px 25px 0 0;

    border-right: 1px solid #333;

    margin-right: 25px;
}

.process-item:last-child {
    border-right: none;
}

.process-item span {
    color: #777;

    font-size: 12px;
}

.process-item h3 {
    margin-top: 45px;

    font-size: 22px;

    font-weight: 500;
}

.process-item p {
    margin-top: 15px;

    color: #888;

    font-size: 13px;
}


/* =========================
   GITHUB
========================= */

.repository {
    max-width: 1200px;

    margin: auto;

    padding: 120px 30px;
}

.repo-content {
    margin-top: 70px;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 80px;

    align-items: center;
}

.repo-content h2 {
    font-size: 55px;

    line-height: 1;

    letter-spacing: -3px;

    font-weight: 500;
}

.repo-content h2 span {
    color: var(--muted);
}

.repo-content p:last-child {
    margin-top: 25px;

    color: var(--muted);

    max-width: 450px;
}

.code-window {
    background: #191b1e;

    color: #b8bec5;

    border-radius: 8px;

    overflow: hidden;

    box-shadow: 0 20px 50px rgba(0,0,0,.12);
}

.window-top {
    height: 38px;

    display: flex;

    align-items: center;

    gap: 6px;

    padding: 0 15px;

    border-bottom: 1px solid #303236;
}

.window-top span {
    width: 8px;

    height: 8px;

    border-radius: 50%;

    background: #555;
}

pre {
    padding: 30px;

    font-size: 12px;

    line-height: 1.7;

    overflow-x: auto;
}


/* =========================
   CONTACT
========================= */

.contact {
    text-align: center;

    padding: 150px 30px;

    border-top: 1px solid var(--border);
}

.contact h2 {
    font-size: 65px;

    line-height: 1;

    letter-spacing: -3px;

    font-weight: 500;
}

.contact h2 span {
    color: var(--muted);
}

.contact > p:last-child {
    color: var(--muted);

    margin-top: 25px;
}


/* =========================
   FOOTER
========================= */

footer {
    max-width: 1200px;

    margin: auto;

    padding: 30px;

    border-top: 1px solid var(--border);

    display: flex;

    justify-content: space-between;

    font-size: 10px;

    letter-spacing: 1px;

    color: var(--muted);
}


/* =========================
   RESPONSIVE
========================= */

@media (max-width: 800px) {

    nav {
        display: none;
    }

    .nav-button {
        display: none;
    }

    .hero {
        min-height: 80vh;

        padding: 80px 25px;
    }

    .hero h1 {
        letter-spacing: -2px;
    }

    .hero-number {
        display: none;
    }

    .hero-actions {
        flex-direction: column;

        align-items: flex-start;
    }

    .about {
        grid-template-columns: 1fr;

        gap: 30px;

        padding: 80px 25px;
    }

    .about-content h2 {
        font-size: 35px;
    }

    .activities {
        padding: 80px 25px;
    }

    .section-heading {
        display: block;
    }

    .section-heading h2 {
        font-size: 38px;
    }

    .section-heading > p {
        margin-top: 15px;
    }

    .activity {
        grid-template-columns: 1fr;
    }

    .activity.reverse .activity-info {
        order: 1;
    }

    .activity-info {
        padding: 60px 0;
    }

    .activity h3 {
        font-size: 35px;
    }

    .activity-preview {
        min-height: 350px;
    }

    .process {
        padding: 80px 25px;
    }

    .process-header {
        grid-template-columns: 1fr;

        gap: 30px;

        margin: 60px auto;
    }

    .process-header h2 {
        font-size: 45px;
    }

    .process-grid {
        grid-template-columns: 1fr 1fr;
    }

    .process-item {
        margin-bottom: 30px;
    }

    .repository {
        padding: 80px 25px;
    }

    .repo-content {
        grid-template-columns: 1fr;

        gap: 50px;
    }

    .repo-content h2 {
        font-size: 45px;
    }

    .contact {
        padding: 100px 25px;
    }

    .contact h2 {
        font-size: 45px;
    }

    footer {
        margin: 0 25px;

        flex-direction: column;

        gap: 10px;
    }
}
